{
  "name": "teerop-pos-backend",
  "version": "1.0.0",
  "description": "Teerop POS & Inventory Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed": "node seed.js"
  },
  "keywords": [
    "pos",
    "inventory",
    "management",
    "postgresql",
    "express"
  ],
  "author": "Teerop",
