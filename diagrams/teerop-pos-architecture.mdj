						"$ref": "AAAAAAGQteeropDomainModel"
					},
					"name": "Product",
					"attributes": [
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_id", "name": "id", "type": "Integer", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_sku", "name": "sku", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_name", "name": "name", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_category", "name": "category", "type": "CategoryEnum ['Fragile', 'Cold', 'Tech', 'Cleaning', 'General']", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_price", "name": "price", "type": "Decimal(10,2)", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_qty", "name": "quantity_in_stock", "type": "Integer", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_reorder", "name": "reorder_threshold", "type": "Integer", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_imageUrl", "name": "image_url", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_hNote", "name": "handling_note", "type": "Text", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_isFrag", "name": "is_fragile", "type": "Boolean", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_expDate", "name": "expiry_date", "type": "DateOnly", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_storTemp", "name": "storage_temp", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_warranty", "name": "warranty_period", "type": "Integer", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_sn", "name": "serial_number", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_isHaz", "name": "is_hazardous", "type": "Boolean", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQP_safeNote", "name": "safety_note", "type": "Text", "visibility": "private" }
					],
					"operations": [
						{ "_type": "UMLOperation", "_id": "AAAAAAGQP_isLow", "name": "+ isLowStock(): Boolean" },
						{ "_type": "UMLOperation", "_id": "AAAAAAGQP_isExp", "name": "+ isExpiringSoon(): Boolean" }
					]
