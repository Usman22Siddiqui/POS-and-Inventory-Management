					"name": "User",
					"attributes": [
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQU_id", "name": "id", "type": "Integer", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQU_username", "name": "username", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQU_email", "name": "email", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQU_password", "name": "password", "type": "String", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQU_role", "name": "role", "type": "RoleEnum ['admin', 'inventory_manager', 'cashier']", "visibility": "private" },
						{ "_type": "UMLAttribute", "_id": "AAAAAAGQU_isActive", "name": "is_active", "type": "Boolean", "visibility": "private" }
					],
					"operations": [
						{ "_type": "UMLOperation", "_id": "AAAAAAGQU_valPass", "name": "+ validatePassword(password: String): Boolean" },
						{ "_type": "UMLOperation", "_id": "AAAAAAGQU_toSafe", "name": "+ toSafeJSON(): Object" }
					]
				},
				{
